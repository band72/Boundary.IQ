{
  "name": "boundary-iq-server",
  "version": "1.0.0",
  "description": "Boundary.IQ API — Node.js port",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint . --ext .js --max-warnings 0",
    "test": "node tests/test_headless_riddle.js && node tests/test_server_headless.js",
    "test:riddle": "node tests/test_headless_riddle.js",
    "test:server": "node tests/test_server_headless.js",
    "test:all": "node tests/test_headless_riddle.js && node tests/test_server_headless.js",
    "test:unit": "vitest run --config vitest.config.js",
    "test:unit:watch": "vitest --config vitest.config.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^11.0.0",
    "canvas": "^3.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "dxf-writer": "^1.18.4",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "stripe": "^22.2.1",
    "undici": "^6.26.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
