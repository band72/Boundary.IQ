{
  "name": "boundary-iq-server",
  "version": "1.0.0",
  "description": "Boundary.IQ API — Node.js port",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint .",
    "test": "node tests/test_headless_riddle.js && node tests/test_server_headless.js",
    "test:riddle": "node tests/test_headless_riddle.js",
    "test:server": "node tests/test_server_headless.js",
    "test:all": "node tests/test_headless_riddle.js && node tests/test_server_headless.js",
    "test:unit": "vitest run --config vitest.config.js",
    "test:unit:watch": "vitest --config vitest.config.js",
    "batch:all": "node scripts/batchHeadless.js",
    "batch:fails": "node scripts/batchHeadless.js --fail-only",
    "batch:ai": "node scripts/batchHeadless.js --use-ai --model=gemini-2.5-flash --fail-only",
    "query:stats": "node tests/list_summaries.js",
    "query:fails": "node tests/query_all_failed.js",
    "reconstruct-plat": "node scripts/reconstruct_plat_to_dxf.js"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "pg": "^8.12.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^11.0.0",
    "canvas": "^3.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "dxf-writer": "^1.18.4",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "stripe": "^22.2.1",
    "undici": "^6.26.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "vitest": "^4.1.9"
  }
}
