# Boundary.IQ — Environment Variable Reference
# Copy this file to server/.env for the Node.js API server.

# Google Gemini Vision API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Port the Node.js API listens on (default: 5050)
PORT=5050

# Ollama base URL (default: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# Full path to the ollama binary if not on PATH (e.g. when using a custom install)
# Default: 'ollama' (uses whatever is in PATH)
# Example for NVM-managed installs or non-standard locations:
# OLLAMA_PATH=/home/friend/.local/bin/ollama
OLLAMA_PATH=/home/friend/.local/bin/ollama

# Allowed root directories for folder scanning (semicolon-separated)
# Leave blank to allow the user's home directory (default behaviour).
# BOUNDARY_SCAN_ROOTS=/home/friend/Deeds;/mnt/NAS/surveys
BOUNDARY_SCAN_ROOTS=
