# Boundary.IQ — Environment Variable Reference
# Copy this file to server/.env for the Node.js API server.

# ── AI Provider ───────────────────────────────────────────────────────────────
# Google Gemini API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Active AI provider: 'gemini' (cloud) | 'ollama' (local) | 'openai'
# Set to 'gemini' when deploying to Cloud Run / Fly.io (no Ollama in cloud)
ACTIVE_PROVIDER=ollama
ACTIVE_MODEL=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Node.js API listens on (default: 5051 dev, 5050 prod/Docker)
PORT=5051
NODE_ENV=development

# ── Local Ollama (dev only) ───────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_PATH=ollama

# ── CORS — Cloud Deployment ───────────────────────────────────────────────────
# Set ONE of these after your first deploy to pin your public URL.
# Any *.run.app or *.fly.dev origin is auto-allowed without setting these.
# CLOUD_RUN_URL=https://boundary-iq-xxxx-uc.a.run.app
# FLY_APP_URL=https://boundary-iq.fly.dev
# FRONTEND_URL=https://your-custom-domain.com

# ── Auth / Email ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
# INVITE_ONLY=false

# ── Billing ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── File Processing ───────────────────────────────────────────────────────────
# Allowed root directories for folder scanning (semicolon-separated)
# Leave blank in cloud deployments — folder scanning is a local-only feature.
# BOUNDARY_SCAN_ROOTS=/home/friend/Deeds;/mnt/NAS/surveys
BOUNDARY_SCAN_ROOTS=
